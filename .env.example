# PostgreSQL Database Configuration
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=finance

# JWT Configuration (gere com: openssl rand -base64 64)
JWT_SECRET=change_me_to_a_strong_random_256_bit_secret_key_in_production
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Cookie & CORS Security (em produção com HTTPS: SECURITY_COOKIE_SECURE=true)
# Se Front e API estiverem em domínios diferentes, use SECURITY_COOKIE_SAME_SITE=None e SECURITY_COOKIE_SECURE=true
SECURITY_COOKIE_SECURE=true
SECURITY_COOKIE_SAME_SITE=Strict
CORS_ALLOWED_ORIGINS=https://seu-dominio.com

# Springdoc / Swagger (desative em produção)
SPRINGDOC_SWAGGER_UI_ENABLED=false
SPRINGDOC_API_DOCS_ENABLED=false

# Timezone
TZ=America/Sao_Paulo

# Configurações do Resend (envio de e-mails transacionais)
# Chave da API do Resend (obtenha em https://resend.com)
RESEND_API_KEY=
# E-mail remetente verificado no Resend (ou onboarding@resend.dev para testes)
RESEND_FROM_EMAIL=onboarding@resend.dev

# URL base da aplicação frontend (para composição dos links de redefinição de senha)
FRONTEND_URL=http://localhost:5173

